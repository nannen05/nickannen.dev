# Calendly event URL to render in the "Book a call" contact tab.
VITE_CALENDLY_URL=https://calendly.com/nannen05/intro-call

# HTTPS endpoint that accepts the contact form as JSON and emails it to you.
# Keep mail-provider credentials on the server, never in this Vite app.
VITE_CONTACT_FORM_ENDPOINT=https://your-domain.com/api/contact
