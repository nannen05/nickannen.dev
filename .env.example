# Calendly event URL to render in the "Book a call" contact tab.
VITE_CALENDLY_URL=https://calendly.com/nannen05/intro-call

# HTTPS endpoint that accepts the contact form as JSON and emails it to you.
# Keep mail-provider credentials on the server, never in this Vite app.
VITE_CONTACT_FORM_ENDPOINT=https://your-domain.com/api/contact
# Privacy-safe outreach visit attribution endpoint (the separately deployed API).
VITE_OUTREACH_EVENT_ENDPOINT=/api/outreach/events

# Outreach service (keep these server-side; sending remains disabled by default).
OUTREACH_ADMIN_USER=admin
OUTREACH_ADMIN_PASSWORD=change-this-before-deploying
# Vercel serves the public marketing site and API routes from one origin.
OUTREACH_WEBSITE_URL=https://www.nickannenofficial.com
OUTREACH_API_URL=https://www.nickannenofficial.com
# Legacy fallback only; prefer the two variables above.
OUTREACH_PUBLIC_URL=
OUTREACH_POSTAL_ADDRESS="Your business postal address"
OUTREACH_LIVE_SENDING=false
CRON_SECRET=generate-a-long-random-secret
# Supabase values are injected by the Vercel Marketplace integration. Do not expose
# SUPABASE_SECRET_KEY in a VITE_ variable or commit it to source control.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional Resend transport. No mail is sent until OUTREACH_LIVE_SENDING=true.
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=Nick Annen
# Optional webhook validation and Calendly attribution.
OUTREACH_WEBHOOK_SECRET=
CALENDLY_WEBHOOK_SECRET=
